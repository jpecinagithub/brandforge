# BrandForge AI — root environment example.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Docker Compose reads this file automatically for the postgres/api/worker services.

# ---------------------------------------------------------------- database
# Postgres connection string used by the API and the worker.
DATABASE_URL=postgresql://brandforge:CHANGE_ME@localhost:5432/brandforge
# Password for the postgres service (must match the user in DATABASE_URL).
POSTGRES_PASSWORD=CHANGE_ME
# Optional: override the database name / user created on first boot.
POSTGRES_DB=brandforge
POSTGRES_USER=brandforge

# ------------------------------------------------------------------- api
# Backend listens on the RESERVED BrandForge port (127.0.0.1:3013 on Oracle).
PORT=3013
NODE_ENV=development              # development | production | test
# Public URL of the frontend (used in emails and CORS checks).
FRONTEND_URL=http://localhost:5173
# Allowed browser origin(s), comma-separated. The browser NEVER talks to OpenRouter.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ mail
# Use a local maildir in dev/test. Set to "smtp" in production.
MAIL_TRANSPORT=maildir             # maildir | smtp
MAIL_FROM="BrandForge <no-reply@brandforge.local>"
# Directory where maildir transport drops .eml files (relative to repo root).
MAILDIR_PATH=./maildir
# Only used when MAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --------------------------------------------------------------- storage
# Local filesystem path for uploaded/generated assets.
STORAGE_PATH=./storage

# --------------------------------------------------------------- sessions
# Server-side session TTL in days (rolling). Demo sessions are shorter (see docs/adr/0005).
SESSION_TTL_DAYS=30

# ------------------------------------------------------------------ web
# Baked into the frontend at build time (Vite). Points the browser at the API.
VITE_API_URL=http://localhost:3013

# ------------------------------------------------------------- openrouter
# AI provider — SERVER-SIDE ONLY. The browser never sees these values; only the
# API/worker on Oracle call OpenRouter. Never put them in VITE_* vars.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model overrides for ModelRouter. Leave empty and the router picks
# verified defaults (see docs/adr/0007-model-router.md).
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_REVIEW_MODEL=

# ------------------------------------------------------------------- agent
# Agent engine tunables (all limits env-config, ADR-0006).
AGENT_MAX_STEPS=25
AGENT_STEP_TIMEOUT_MS=120000
AGENT_RUN_TIMEOUT_MS=1800000
AGENT_DEFAULT_BUDGET_USD=2.00
AGENT_MAX_ATTEMPTS=3
# Public demo guardrails. Keep the allowance intentionally small: each demo
# workspace is isolated and expires after 24 hours.
DEMO_AI_ENABLED=false
DEMO_MONTHLY_AI_GENERATIONS=2
DEMO_MONTHLY_CREDITS_USD=0.15
FREE_MONTHLY_AI_CREDITS=100
FREE_MONTHLY_CREDITS_USD=5
PRO_MONTHLY_AI_CREDITS=1000
PRO_MONTHLY_CREDITS_USD=50
