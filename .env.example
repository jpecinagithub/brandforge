# BrandForge AI — root environment example.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Docker Compose reads this file automatically for the postgres/api/worker services.

# ---------------------------------------------------------------- database
# Postgres connection string used by the API and the worker.
DATABASE_URL=postgresql://brandforge:CHANGE_ME@localhost:5432/brandforge
# Password for the postgres service (must match the user in DATABASE_URL).
POSTGRES_PASSWORD=CHANGE_ME
# Optional: override the database name / user created on first boot.
POSTGRES_DB=brandforge
POSTGRES_USER=brandforge

# ------------------------------------------------------------------- api
# Backend listens on the RESERVED BrandForge port (127.0.0.1:3013 on Oracle).
PORT=3013
NODE_ENV=development              # development | production | test
# Public URL of the frontend (used in emails and CORS checks).
FRONTEND_URL=http://localhost:5173
# Allowed browser origin(s), comma-separated. The browser NEVER talks to OpenRouter.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------ mail
# Phase 1–2 use a local maildir (dev/test). Set to "smtp" in production.
MAIL_TRANSPORT=maildir             # maildir | smtp
MAIL_FROM="BrandForge <no-reply@brandforge.local>"
# Directory where maildir transport drops .eml files (relative to repo root).
MAILDIR_PATH=./maildir
# Only used when MAIL_TRANSPORT=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --------------------------------------------------------------- storage
# Local filesystem path for uploaded/generated assets (Phase 3+).
STORAGE_PATH=./storage

# --------------------------------------------------------------- sessions
# Server-side session TTL in days (rolling). Demo sessions are shorter (see docs/adr/0005).
SESSION_TTL_DAYS=30

# ------------------------------------------------------------------ web
# Baked into the frontend at build time (Vite). Points the browser at the API.
VITE_API_URL=http://localhost:3013

# ------------------------------------------------------------- openrouter
# Phase 3 — NOT USED YET. The browser never sees these; only the API/worker call OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
