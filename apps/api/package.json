{
  "dependencies": {
    "@brandforge/agent-server": "0.1.0",
    "@brandforge/database": "0.1.0",
    "@brandforge/shared": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.3",
    "argon2": "^0.44.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.4.0",
    "nodemailer": "^6.10.1",
    "zod": "^3.23.8"
  },
  "description": "BrandForge REST API (Fastify + TypeScript) — auth, workspaces, projects, assets, admin",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "name": "@brandforge/api",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace=@brandforge/shared --workspace=@brandforge/database && tsc -p tsconfig.json",
    "cleanup-demos": "tsx src/scripts/cleanup-demos.ts",
    "dev": "tsx watch src/index.ts",
    "promote-admin": "tsx src/scripts/promote-admin.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
